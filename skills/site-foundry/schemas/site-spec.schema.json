{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_type", "audience", "primary_goal", "routes", "required_interactions", "brand_attributes", "content_density", "motion_level", "stack", "assumptions", "prohibited_claims"],
  "properties": {
    "site_type": { "type": "string", "minLength": 1 },
    "audience": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "primary_goal": { "type": "string", "minLength": 1 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "purpose": { "type": "string", "minLength": 1 },
          "states": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "required_interactions": { "type": "array", "items": { "type": "string" } },
    "brand_attributes": { "type": "array", "items": { "type": "string" } },
    "content_density": { "enum": ["low", "moderate", "dense"] },
    "motion_level": { "enum": ["none", "restrained", "expressive"] },
    "stack": { "const": "react-typescript-tailwind" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "prohibited_claims": { "type": "array", "items": { "type": "string" } }
  }
}
