{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["component_id", "source_url", "canonical_repository", "revision", "author", "license", "files_copied", "dependencies_added", "adaptations", "screenshots", "decision"],
  "properties": {
    "component_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "pattern": "^https://" },
    "canonical_repository": { "type": "string", "pattern": "^https://" },
    "revision": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "license": { "enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"] },
    "files_copied": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies_added": { "type": "array", "items": { "type": "string" } },
    "adaptations": { "type": "array", "items": { "type": "string" } },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["accepted", "rejected"] }
  }
}
